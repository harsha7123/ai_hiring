# ---------- Required ----------
# PostgreSQL 14+ connection string. Set DATABASE_SSL=true for managed databases that require TLS.
DATABASE_URL=postgres://user:password@host:5432/shortlist
DATABASE_SSL=false

# Public https URL of this deployment. Used in candidate invite links and the OmniDimension webhook.
APP_URL=https://hire.yourdomain.com

# 32 random bytes, base64. Encrypts stored secrets (per-tenant OmniDimension keys). Never change after launch.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# ---------- AI (Claude) ----------
ANTHROPIC_API_KEY=
# Fast model for high-volume CV parsing/scoring; smart model for questions, interview scoring and reports.
AI_MODEL_FAST=claude-haiku-4-5
AI_MODEL_SMART=claude-opus-5
# true = deterministic heuristics instead of Claude (local testing only)
AI_DEMO_MODE=false

# ---------- Voice interviews (OmniDimension) ----------
# Platform-wide key. Each workspace can also save its own key in Settings, which takes precedence.
OMNIDIM_API_KEY=
# OMNIDIM_BASE_URL=https://backend.omnidim.io/api/v1

# ---------- Candidate messaging (optional) ----------
# Without these, recruiters copy invite links from the dashboard.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sender number (E.164) or approved WhatsApp sender
TWILIO_FROM=
# sms | whatsapp
TWILIO_CHANNEL=sms

# ---------- Behaviour ----------
# Allow anyone to create a workspace (multi-tenant self-service). Set false for invite-only.
ALLOW_SIGNUP=true
# Country code applied to 10-digit phone numbers without one
DEFAULT_COUNTRY_CODE=91
# Company-local time zone offset for calling hours (IST = 330)
APP_TZ_OFFSET_MINUTES=330
# Fast-pass floor: CVs below this % requirement match skip model scoring (still promotable)
LEXICAL_FLOOR=15
MAX_CVS_PER_ROLE=5000

# ---------- Scaling ----------
# Parallel background jobs per process
WORKER_CONCURRENCY=6
DB_POOL_SIZE=10
# Set RUN_WORKER=false on web instances when running `npm run worker` as a separate service
RUN_WORKER=true
RUN_MIGRATIONS=true
