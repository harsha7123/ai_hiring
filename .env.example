# ---------- Required: database ----------
# PostgreSQL 14+ connection string. If you're using Supabase, this is the
# "Connection string" (URI, transaction pooler is fine) from
# Project Settings -> Database. Set DATABASE_SSL=true for Supabase / any
# managed database that requires TLS.
DATABASE_URL=postgres://user:password@host:5432/shortlist
DATABASE_SSL=false

# Public https URL of this deployment. Used in candidate invite links and the OmniDimension webhook.
APP_URL=https://hire.yourdomain.com

# 32 random bytes, base64. Encrypts stored secrets (per-tenant OmniDimension keys). Never change after launch.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# ---------- Required: Supabase Auth ----------
# From your Supabase project: Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key. Server-only, never exposed to the browser. Currently only
# reserved for future admin-only Supabase Auth calls; keep it set.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- AI (OpenAI) ----------
OPENAI_API_KEY=
# Fast model for high-volume CV parsing/scoring; smart model for questions, interview scoring and reports.
AI_MODEL_FAST=gpt-5-mini
AI_MODEL_SMART=gpt-5
# true = deterministic heuristics instead of the AI model (local testing only)
AI_DEMO_MODE=false

# ---------- Voice interviews (OmniDimension) ----------
# Configured entirely here — there is no admin UI for this. With this key set,
# every workspace's interview agent is created automatically at signup.
OMNIDIM_API_KEY=
# OMNIDIM_BASE_URL=https://backend.omnidim.io/api/v1
# Optional: your OmniDimension outbound Caller ID (Dashboard -> Phone Numbers).
# Only needed to offer "phone call" as an interview mode for a role (set per
# role in that role's own Settings tab) instead of in-browser only.
OMNIDIM_FROM_NUMBER_ID=

# ---------- Candidate messaging (optional, but at least one recommended) ----------
# Without any of these, recruiters copy invite links from the dashboard and share
# them manually — nothing is sent to candidates automatically.

# Email, via Resend (resend.com has a free tier). Sends the interview invite and
# the "you've been shortlisted" notification.
RESEND_API_KEY=
# Must be a verified sender/domain in your Resend account, e.g. "Acme Hiring <hire@acme.com>"
EMAIL_FROM=

# SMS / WhatsApp, via Twilio. Sends only the interview invite.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sender number (E.164) or approved WhatsApp sender
TWILIO_FROM=
# sms | whatsapp
TWILIO_CHANNEL=sms

# ---------- Behaviour ----------
# Allow anyone to create a workspace (multi-tenant self-service). Set false for invite-only.
ALLOW_SIGNUP=true
# Country code applied to 10-digit phone numbers without one
DEFAULT_COUNTRY_CODE=91
# Fast-pass floor: CVs below this % requirement match skip model scoring (still promotable)
LEXICAL_FLOOR=15
MAX_CVS_PER_ROLE=5000

# ---------- Scaling ----------
# Parallel background jobs per process
WORKER_CONCURRENCY=6
DB_POOL_SIZE=10
# Set RUN_WORKER=false on web instances when running `npm run worker` as a separate service
RUN_WORKER=true
RUN_MIGRATIONS=true
